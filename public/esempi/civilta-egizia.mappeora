{"format":"mappeora","version":1,"map":{"id":"874546d1-bda3-443d-838d-3f23698de3e1","title":"La civiltà egizia","createdAt":1792515037245,"updatedAt":1792515037245,"template":"libera","nodes":[{"id":"0c4406f2-df06-44d9-9fee-ec3f74a0553e","label":"La civiltà egizia\n3100 a.C. – 30 a.C.","position":{"x":0,"y":0},"color":"#ffffff","shape":"ellisse","image":{"kind":"illustrazione","ref":"Amphora/3D/amphora_3d","src":"data:image/png;base64,"}},{"id":"5a148387-630d-4bb5-8608-f87250ee5fe5","label":"Il Nilo","position":{"x":56,"y":130},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"fae194ec-bbd7-4a8f-8a71-8a9a1b0d548c","label":"«L’Egitto è un dono del Nilo»: lo scrive lo storico greco Erodoto","position":{"x":112,"y":230},"color":"#ffffff","shape":"rettangolo"},{"id":"1b7f9375-afcf-4150-beeb-74174c09e360","label":"Ogni estate il fiume si ingrossa e inonda i campi: è la piena","position":{"x":112,"y":330},"color":"#ffffff","shape":"rettangolo","image":{"kind":"illustrazione","ref":"Water wave/3D/water_wave_3d","src":"data:image/png;base64,"}},{"id":"8fae1b82-a0fb-4b3b-99ae-481f2ca26fca","label":"Quando l’acqua si ritira lascia il limo, un fango nero e fertile","position":{"x":112,"y":430},"color":"#ffffff","shape":"rettangolo"},{"id":"b62e00e8-7dfc-4e23-a5a4-7bb8467fa969","label":"I contadini coltivano grano, orzo, lino e papiro","position":{"x":112,"y":530},"color":"#ffffff","shape":"rettangolo"},{"id":"1f423b27-05d5-4575-8925-07d03d1fd48a","label":"Oltre la valle c’è il deserto, la «terra rossa»","position":{"x":112,"y":630},"color":"#ffffff","shape":"rettangolo"},{"id":"00e220a3-06b5-49a1-81cf-1a3b99279e81","label":"Le epoche","position":{"x":56,"y":760},"color":"#ffffff","shape":"rettangolo"},{"id":"441924fd-03a7-45cf-86dd-83f14b4ab9ba","label":"Circa 3100 a.C.: il re Narmer unisce l’Alto e il Basso Egitto","position":{"x":112,"y":860},"color":"#ffffff","shape":"rettangolo"},{"id":"968ff050-1ea8-4400-9b56-a4ef5a4e31cc","label":"Antico Regno (circa 2700 – 2200 a.C.): l’età delle piramidi","position":{"x":112,"y":960},"color":"#ffffff","shape":"rettangolo"},{"id":"470f1216-50f3-49e8-9db5-989f2ce84e68","label":"Medio Regno (circa 2050 – 1650 a.C.)","position":{"x":112,"y":1060},"color":"#ffffff","shape":"rettangolo"},{"id":"ffe1fe08-fefc-4ec8-8c25-c88dcb33943b","label":"Nuovo Regno (circa 1550 – 1070 a.C.): l’Egitto è più potente e ricco","position":{"x":112,"y":1160},"color":"#ffffff","shape":"rettangolo"},{"id":"af0d67ae-adb5-489b-8a6d-bdff7deed9e8","label":"30 a.C.: l’Egitto diventa una provincia di Roma","position":{"x":112,"y":1260},"color":"#ffffff","shape":"rettangolo"},{"id":"dedd357e-fe4b-4de1-b716-3691fdd1ee62","label":"Le classi sociali","position":{"x":56,"y":1390},"color":"#ffffff","shape":"rettangolo"},{"id":"7f96b0d2-40d5-4f3a-a863-e45949f38b60","label":"Il faraone: il re, considerato figlio degli dèi. Comanda su tutto","position":{"x":112,"y":1490},"color":"#ffffff","shape":"rettangolo","image":{"kind":"illustrazione","ref":"Crown/3D/crown_3d","src":"data:image/png;base64,"}},{"id":"cb099076-d8a3-4d4f-b86f-4a43492f22f1","label":"I sacerdoti: servono gli dèi nei templi","position":{"x":112,"y":1590},"color":"#ffffff","shape":"rettangolo"},{"id":"d1abb0f2-fc49-4f74-ba47-edf2b7163124","label":"Gli scribi: sanno scrivere e contare. Segnano raccolti e tasse","position":{"x":112,"y":1690},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"51ad6d26-2243-442a-955a-6f4ded45d6fa","label":"I contadini e gli artigiani: coltivano, costruiscono e producono","position":{"x":112,"y":1790},"color":"#ffffff","shape":"rettangolo"},{"id":"0b30478c-9cc0-45c7-8d3c-d2b79fdb6f48","label":"Gli schiavi: spesso prigionieri di guerra, senza diritti","position":{"x":112,"y":1890},"color":"#ffffff","shape":"rettangolo"},{"id":"ef91d10c-28fc-4720-9c00-a57316972b52","label":"Gli dèi e l’aldilà","position":{"x":56,"y":2020},"color":"#ffffff","shape":"rettangolo"},{"id":"a893bb2b-24d7-44e2-b164-6a6cae3b199b","label":"Tanti dèi (politeismo), spesso con la testa di un animale","position":{"x":112,"y":2120},"color":"#ffffff","shape":"rettangolo"},{"id":"422283ea-a9e3-43a5-bd44-33296a552a7f","label":"Ra: il dio del sole","position":{"x":168,"y":2220},"color":"#ffffff","shape":"rettangolo","image":{"kind":"illustrazione","ref":"Sun/3D/sun_3d","src":"data:image/png;base64,"}},{"id":"fd49dba9-a4c7-4204-847d-20ffec4488c0","label":"Osiride: dio dei morti e della rinascita","position":{"x":168,"y":2320},"color":"#ffffff","shape":"rettangolo"},{"id":"f4a82c08-3a61-42e9-932e-d5144c9a6d65","label":"Iside: dea della magia, moglie di Osiride","position":{"x":168,"y":2420},"color":"#ffffff","shape":"rettangolo"},{"id":"365a2336-043a-4ef0-8158-8f02f81d5544","label":"Anubi: dio con la testa di sciacallo, accompagna i morti","position":{"x":168,"y":2520},"color":"#ffffff","shape":"rettangolo"},{"id":"13dbb250-8729-4fa1-b7e9-364a6560841b","label":"La vita dopo la morte","position":{"x":112,"y":2620},"color":"#ffffff","shape":"rettangolo"},{"id":"41689c4c-aa68-41be-b682-ead6b862e51a","label":"Gli Egizi credono nell’aldilà: la vita continua dopo la morte","position":{"x":168,"y":2720},"color":"#ffffff","shape":"rettangolo"},{"id":"2d0047d4-d14e-4caa-8584-c3a516266e18","label":"Il corpo si conserva con la mummificazione e si mette in un sarcofago","position":{"x":168,"y":2820},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"d5d41e42-9dee-4957-b38c-d60c1782a4be","label":"Nella tomba si lasciano cibo e oggetti, per il viaggio nell’aldilà","position":{"x":168,"y":2920},"color":"#ffffff","shape":"rettangolo"},{"id":"77756271-e441-4b8c-b50b-9dd04382a897","label":"Osiride pesa il cuore del morto: chi è stato buono può entrare nell’aldilà","position":{"x":168,"y":3020},"color":"#ffffff","shape":"rettangolo"},{"id":"ae279900-5b58-4717-9eba-6e3cb848e806","label":"Piramidi e templi","p