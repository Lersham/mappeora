5f-4a80-a780-74b054e1753c","label":"Pietra di Rosetta (trovata nel 1799): lo stesso testo in geroglifico, demotico e greco","position":{"x":112,"y":4180},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"d78619e4-d14e-4fd7-a164-e0d2bacf0363","label":"1822: Champollion la usa per decifrare i geroglifici","position":{"x":112,"y":4280},"color":"#ffffff","shape":"rettangolo"},{"id":"6bec3e17-1021-4140-a329-92f52ed0b50d","label":"I faraoni più famosi","position":{"x":56,"y":4410},"color":"#ffffff","shape":"rettangolo"},{"id":"1cd07308-f36f-4248-a03f-2ea858ac20f1","label":"Cheope (circa 2600 a.C.): fa costruire la Grande Piramide di Giza","position":{"x":112,"y":4510},"color":"#ffffff","shape":"rettangolo"},{"id":"ea0ac9b0-b1be-43cf-8057-0e473a0154b7","label":"Hatshepsut (circa 1470 a.C.): una delle poche donne faraone","position":{"x":112,"y":4610},"color":"#ffffff","shape":"rettangolo"},{"id":"68257a99-387a-4225-bf8c-b2ad7c118d54","label":"Ramses II (1279 – 1213 a.C.): regna 66 anni. Fa costruire Abu Simbel","position":{"x":112,"y":4710},"color":"#ffffff","shape":"rettangolo"},{"id":"76e75d38-8dd2-4be5-a0ac-e31c8af09668","label":"Tutankhamon (circa 1332 – 1323 a.C.): diventa faraone da bambino. La sua tomba è stata trovata quasi intatta nel 1922","position":{"x":112,"y":4810},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"177a3e5e-3266-471a-9a56-a080cf23e8a9","label":"Cleopatra VII (69 – 30 a.C.): l’ultima regina d’Egitto","position":{"x":112,"y":4910},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}}],"edges":[{"id":"e4c8e5b7-8ff5-44c1-8b7d-07de5fbb828a","source":"0c4406f2-df06-44d9-9fee-ec3f74a0553e","target":"5a148387-630d-4bb5-8608-f87250ee5fe5","label":"dipende da"},{"id":"dbf72b68-38b9-44f0-9f18-47d4a02fdc42","source":"5a148387-630d-4bb5-8608-f87250ee5fe5","target":"fae194ec-bbd7-4a8f-8a71-8a9a1b0d548c"},{"id":"