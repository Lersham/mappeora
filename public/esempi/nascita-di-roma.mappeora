{"format":"mappeora","version":1,"map":{"id":"842250e3-aa29-4f94-8511-865d2f61a8f1","title":"La nascita di Roma","createdAt":1792515197137,"updatedAt":1792515197137,"template":"libera","nodes":[{"id":"d040168d-e3f9-4c26-bb98-9b3f4b19b8fe","label":"La nascita di Roma\nVIII – VI secolo a.C.","position":{"x":0,"y":0},"color":"#ffffff","shape":"ellisse","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"5fd673d0-3c0a-4fe3-a0be-5ce5154570b4","label":"La leggenda","position":{"x":56,"y":130},"color":"#ffffff","shape":"rettangolo","image":{"kind":"illustrazione","ref":"Open book/3D/open_book_3d","src":"data:image/png;base64,"}},{"id":"218e2b0a-5251-4634-bbf3-8cd5658ffe1a","label":"È un mito: spiega le origini di Roma e le dà un fondatore divino. Non è storia documentata","position":{"x":112,"y":230},"color":"#ffffff","shape":"rettangolo"},{"id":"e2353639-e3da-4129-bcb0-f923dbf89534","label":"Enea, principe di Troia, scappa dalla città in fiamme e arriva nel Lazio","position":{"x":112,"y":330},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"1a352110-aaf1-4edd-8ca0-c3114f04a58a","label":"I suoi discendenti regnano ad Alba Longa","position":{"x":112,"y":430},"color":"#ffffff","shape":"rettangolo"},{"id":"cca674e8-e3fe-43c3-8783-72555a3bc7ec","label":"Romolo e Remo: gemelli, figli del dio Marte e di Rea Silvia, abbandonati sul Tevere","position":{"x":112,"y":530},"color":"#ffffff","shape":"rettangolo"},{"id":"bae19efa-48e9-4c70-9d4c-ae07bc6517e3","label":"Li salva e li allatta una lupa. Poi li trova il pastore Faustolo","position":{"x":112,"y":630},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"85115f2b-f054-4a7b-a19f-638cf0c07af8","label":"Da grandi fondano una città: Romolo sceglie il colle Palatino","position":{"x":112,"y":730},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"386fcc56-6c91-42ec-8065-a5c06608076c","label":"Romolo traccia con l’aratro un solco: è il confine sacro della città","position":{"x":112,"y":830},"color":"#ffffff","shape":"rettangolo"},{"id":"45677e52-44e8-4205-87d0-a62d3e20ae05","label":"Remo scavalca il solco e Romolo lo uccide. Romolo resta solo, primo re di Roma","position":{"x":112,"y":930},"color":"#ffffff","shape":"rettangolo"},{"id":"85e333fa-083b-42bf-9df3-78b741492a8b","label":"21 aprile 753 a.C.: la data tradizionale della fondazione, calcolata dallo studioso romano Varrone","position":{"x":112,"y":1030},"color":"#ffffff","shape":"rettangolo"},{"id":"bf5fd0b2-2069-4da8-8895-f398399d882d","label":"La storia vera (archeologia)","position":{"x":56,"y":1160},"color":"#ffffff","shape":"rettangolo","image":{"kind":"illustrazione","ref":"Amphora/3D/amphora_3d","src":"data:image/png;base64,"}},{"id":"962e6ef0-81b6-460f-8a64-4889743b42f0","label":"Nel IX – VIII secolo a.C. sui colli ci sono villaggi di pastori e contadini, con capanne di legno e paglia","position":{"x":112,"y":1260},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"328fa1c6-317b-49b5-b66d-1db94152ec8e","label":"Il Tevere: vicino all’isola Tiberina c’è un guado, un punto dove si può attraversare il fiume","position":{"x":112,"y":1360},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"89901113-e4a1-4336-ac99-5e2a282deba7","label":"Passa di qui la strada del sale, che dal mare porta il sale all’interno. Roma controlla il passaggio","position":{"x":112,"y":1460},"color":"#ffffff","shape":"rettangolo"},{"id":"ed509207-a87c-4e63-bb7f-bd0aa814b7d4","label":"Latini e Sabini: popoli vicini, che vivono sui colli e si mescolano","position":{"x":112,"y":1560},"color":"#ffffff","shape":"rettangolo"},{"id":"5b6c1481-4a4f-45a7-bc13-56a060781cb5","label":"Tra l’VIII e il VII secolo a.C. i villaggi dei sette colli si uniscono in una sola città","position":{"x":112,"y":1660},"color":"#ffffff","shape":"rettangolo"},{"id":"4ed3db84-3699-4bfa-aac1-d7a167b2cd53","label":"Gli Etruschi, a nord del Tevere, sono molto sviluppati e influenzano Roma: mura, templi, strade e fogne","position":{"x":112,"y":1760},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"cee87adc-50ff-4cd1-b3a4-361ac01412b1","label":"Non sappiamo se Romolo sia davvero esistito","position":{"x":112,"y":1860},"color":"#ffffff","shape":"rettangolo"},{"id":"05eeb802-1e6b-4656-8c91-76389608e384","label":"I sette re","position":{"x":56,"y":1990},"color":"#ffffff","shape":"rettangolo","image":{"kind":"illustrazione","ref":"Crown/3D/crown_3d","src":"data:image/png;base64,"}},{"id":"c5c31ca0-da25-4a0c-a9b1-d4d48ae3788c","label":"Le date sono quelle della tradizione: i primi re sono in parte leggendari","position":{"x":112,"y":2090},"color":"#ffffff","shape":"rettangolo"},{"id":"4f896ee0-a0d2-43d9-b86b-f9d67dc476af","label":"1. Romolo (753 – 716 a.C.): fonda la città e crea il Senato","position":{"x":112,"y":2190},"color":"#ffffff","shape":"rettangolo"},{"id":"07ccb059-a45e-4436-bf0a-3d96574a1230","label":"2. Numa Pompilio (715 – 673 a.C.): re pacifico, organizza la religione","position":{"x":112,"y":2290},"color":"#ffffff","shape":"rettangolo"},{"id":"a68246cd-99f3-4f97-b688-3480aa53ba8f","label":"3. Tullo Ostilio (673 – 642 a.C.): re guerriero, distrugge Alba Longa","position":{"x":112,"y":2390},"color":"#ffffff","shape":"rettangolo"},{"id":"955fecd4-aaf3-4788-a3a7-09039d92cf63","label":"4. Anco Marzio (642 – 617 a.C.): fonda il porto di Ostia","position":{"x":112,"y":2490},"color":"#ffffff","shape":"rettangolo"},{"id":"77665786-b87a-4bca-8daf-578d3d8738a8","label":"5. Tarquinio Prisco (616 – 579 a.C.): re etrusco, costruisce il Circo Massimo","position":{"x":112,"y":2590},"color":"#ffffff","shape":"rettangolo"},{"id":"6507fddc-3f56-4823-9845-09bebe391ecd","label":"6. Servio Tullio (578 – 535 a.C.): divide i cittadini in classi secondo la ricchezza, costruisce le mura","position":{"x":112,"y":2690},"color":"#ffffff","shape":"rettangolo"},{"id":"48ee2d77-735d-4d3b-bdcf-e961ae82f24d","label":"7. Tarquinio il Superbo (534 – 509 a.C.): re etrusco, governa da tiranno","position":{"x":112,"y":2790},"color":"#ffffff","shape":"rettangolo"},{"id":"f9a8f1a3-dbed-4d33-9a64-eb3825183931","label":"La società","position":{"x":56,"y":2920},"color":"#ffffff","shape":"rettangolo"},{"id":"20892b2d-1ba6-4029-beb6-be4f387667a4","label":"Il re: capo dell’esercito, giudice e sacerdote","position":{"x":112,"y":3020},"color":"#ffffff","shape":"rettangolo"},{"id":"703ab5b6-e62a-48c1-8552-b4cb10f39973","label":"Patrizi: famiglie nobili e ricche. Hanno il potere","position":{"x":112,"y":3120},"color":"#ffffff","shape":"rettangolo"},{"id":"2aec30af-2af0-4a11-a826-731744f13942","label":"Plebei: gli altri cittadini, come contadini, artigiani e commercianti. Non contano nelle decisioni","position":{"x":112,"y":3220},"color":"#ffffff","shape":"rettangolo"},{"id":"3358c83c-f452-4467-9f75-e76c1bd433cf","label":"Il Senato: il consiglio degli anziani patrizi, che consiglia il re","position":{"x":112,"y":3320},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"3772ccd1-f44a-4b00-904e-6b888a08eec3","label":"Schiavi: non hanno diritti","position":{"x":112,"y":3420},"color":"#ffffff","shape":"rettangolo"},{"id":"c3aa0a80-4d1f-491f-b690-fd5df7b1c6a7","label":"La fine della monarchia","position":{"x":56,"y":3550},"color":"#ffffff","shape":"rettangolo","image":{"kind":"illustrazione","ref":"Classical building/3D/classical_building_3d","src":"data:image/png;base64,"}},{"id":"48b23eba-c697-4f9e-8ee6-54138d81efc6","label":"Tarquinio il Superbo governa da tiranno e i Romani si ribellano","position":{"x":112,"y":3650},"color":"#ffffff","shape":"rettangolo"},{"id":"abff9427-57c7-40a7-8316-e82f62658f3d","label":"509 a.C. (secondo la tradizione): i Romani, guidati da Lucio Giunio Bruto, cacciano il re","position":{"x":112,"y":3750},"color":"#ffffff","shape":"rettangolo","image":{"kind":"foto","ref":"data:image/jpeg;base64,"}},{"id":"5fe7ce77-a8ea-44fa-8fa3-512df8c811e6","label":"Il potere passa a due consoli, eletti ogni anno","position":{"x":112,"y":3850},"color":"#ffffff","shape":"rettangolo"},{"id":"f3b4b3de-6d0b-4e76-9260-2b14cf14f77c","label":"Nasce la Repubblica romana","position":{"x":112,"y":3950},"color":"#ffffff","shape":"rettangolo"},{"id":"85ab7c3f-71bc-49aa-8cb2-0d36394c97f1","label":"Per gli storici il cambiamento fu forse più lento di così","position":{"x":112,"y":4050},"color":"#ffffff","shape":"rettangolo"},{"id":"e3af2720-7141-4088-8f9c-42fc0bc15772","label":"I Romani non vorranno mai più un re","position":{"x":112,"y":4150},"color":"#ffffff","shape":"rettangolo"}],"edges":[{"id":"10d33380-ac2d-4076-bdd3-bf57f1db6b12","source":"d040168d-e3f9-4c26-bb98-9b3f4b19b8fe","target":"5fd673d0-3c0a-4fe3-a0be-5ce5154570b4","label":"si racconta nella"},{"id":"50b13291-0a29-47e4-8f47-658372691111","source":"5fd673d0-3c0a-4fe3-a0be-5ce5154570b4","target":"218e2b0a-5251-4634-bbf3-8cd5658ffe1a"},{"id":"88de4445-5c6f-4d04-82c1-c4aa8956d3c7","source":"5fd673d0-3c0a-4fe3-a0be-5ce5154570b4","target":"e2353639-e3da-4129-bcb0-f923dbf89534"},{"id":"fb7e2a7f-38c6-4074-835b-4ca43e91cc89","source":"5fd673d0-3c0a-4fe3-a0be-5ce5154570b4","target":"1a352110-aaf1-4edd-8ca0-c3114f04a58a"},{"id":"00ae2f46-66e3-45fe-91ca-298554e2d055","source":"5fd673d0-3c0a-4fe3-a0be-5ce5154570b4","target":"cca674e8-e3fe-43c3-8783-72555a3bc7ec"},{"id":"8caef1b7-b6e1-4cfa-a3dd-c1c449bcc27f","source":"5fd673d0-3c0a-4fe3-a0be-5ce5154570b4","target":"bae19efa-48e9-4c70-9d4c-ae07bc6517e3"},{"id":"2cc33aeb-1210-40d8-b18e-d71665c9e414","source":"5fd673d0-3c0a-4fe3-a0be-5ce5154570b4","target":"85115f2b-f054-4a7b-a19f-638cf0c07af8"},{"id":"0f83866e-a138-4b9b-a363-ff7cf92fb561","source":"5fd673d0-3c0a-4fe3-a0be-5ce5154570b4","target":"386fcc56-6c91-42ec-8065-a5c06608076c"},{"id":"3ff75021-c973-4cef-